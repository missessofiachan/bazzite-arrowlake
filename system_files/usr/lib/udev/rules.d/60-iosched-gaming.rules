# NVMe SSDs: no software scheduler overhead, 2MB read-ahead for .pack streaming, strict CPU core affinity
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none", ATTR{queue/read_ahead_kb}="2048", ATTR{queue/nr_requests}="2048", ATTR{queue/rq_affinity}="2"

# SATA / USB SSDs (like your Samsung 860 EVO): mq-deadline + 1MB read-ahead
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline", ATTR{queue/read_ahead_kb}="1024", ATTR{queue/rq_affinity}="2"
