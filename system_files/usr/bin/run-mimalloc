#!/usr/bin/bash
if [ $# -eq 0 ]; then
    echo "Usage: run-mimalloc <command> [args...]"
    echo "Runs <command> with Arrow Lake-S optimized mimalloc (libmimalloc.so.2) preloaded."
    echo "Example for Steam Launch Options: run-mimalloc %command%"
    exit 1
fi
export LD_PRELOAD="/usr/lib64/libmimalloc.so.2${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$@"
