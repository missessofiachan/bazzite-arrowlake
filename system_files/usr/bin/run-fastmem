#!/usr/bin/bash
if [ $# -eq 0 ]; then
    echo "Usage: run-fastmem <command> [args...]"
    echo "Runs <command> with Arrow Lake-S optimized fastmem primitives (libfastmem.so) preloaded."
    echo "Example for Steam Launch Options: run-fastmem %command%"
    exit 1
fi
export LD_PRELOAD="/usr/lib64/libfastmem.so${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$@"
